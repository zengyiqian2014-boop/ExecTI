#include <winver.h>

// Embed the application manifest so Windows prompts for elevation (UAC).
// RT_MANIFEST = 24, CREATEPROCESS_MANIFEST_RESOURCE_ID = 1
1 24 "execti.manifest"

// Application icon (lowest id -> what Explorer / taskbar show).
1 ICON "execti.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,1,0
 PRODUCTVERSION 2,0,1,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Open Source"
      VALUE "FileDescription",  "ExecTI CLI - run a program as TrustedInstaller (full edition)"
      VALUE "FileVersion",      "2.0.1.0"
      VALUE "InternalName",     "execti-cli"
      VALUE "OriginalFilename", "execti-cli.exe"
      VALUE "ProductName",      "ExecTI"
      VALUE "ProductVersion",   "2.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
