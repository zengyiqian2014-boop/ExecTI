#include <winver.h>

// Embed the application manifest so Windows prompts for elevation (UAC).
// RT_MANIFEST = 24, CREATEPROCESS_MANIFEST_RESOURCE_ID = 1
1 24 "execti.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Open Source"
      VALUE "FileDescription",  "ExecTI - run a program as TrustedInstaller"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "execti"
      VALUE "OriginalFilename", "execti.exe"
      VALUE "ProductName",      "ExecTI"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
